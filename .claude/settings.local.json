  "model": "claude-opus-4-7",
  "version": "1.0",
  "extends": ".claude/settings.json",
  "debugging": {
    "verboseLogging": true,
    "logLevel": "debug",
    "showTokenUsage": true,
    "showToolCalls": true
  },
  "experimental": {
    "enableMultiAgent": true,
    "enablePromptCaching": true,
    "enableStreaming": true
  },
  "localOnly": {
    "allowUnsafeCommands": false,
    "mockExternalServices": true,
    "useLocalDB": true
  },
  "devShortcuts": {
    "quickTest": "npm test -- --watch",
    "quickBuild": "npm run build",
    "quickLint": "npm run lint",
    "quickFormat": "npm run format"
  },
  "mockServices": {
    "ai": true,
    "twilio": true,
    "whatsapp": true,
    "email": true
