    {
      "parameters": {
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key={{$env.GEMINI_API_KEY}}",
        "method": "POST",
        "sendHeaders": true,
        "headers": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"role\": \"user\",\n      \"parts\": [\n        {\n          \"text\": \"Analyze the user request and extract any of these 8 appointment booking details. If not mentioned in the message, output null for that field:\\n1. fullName (Client full name)\\n2. serviceName (Name of service like Gel Manicure, Pedicure, Botox, Lip Filler etc)\\n3. preferredDate (Target booking date formatted as YYYY-MM-DD)\\n4. preferredTime (Target booking time formatted as HH:MM:SS or HH:MM)\\n5. paymentMethod (cash, card, online)\\n6. paymentStatus (pending or paid, defaults to pending)\\n7. notes (technician request or custom request)\\n\\nReturn ONLY a raw JSON string like this: { \\\"fullName\\\": null, \\\"serviceName\\\": \\\"Gel Manicure\\\", \\\"preferredDate\\\": \\\"2026-06-01\\\", \\\"preferredTime\\\": \\\"14:00\\\", \\\"paymentMethod\\\": null, \\\"paymentStatus\\\": \\\"pending\\\", \\\"notes\\\": null } without markdown blocks.\\n\\nCustomer Message: {{ $('WhatsApp Trigger').item.json.messages[0].text.body }}\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0.1,\n    \"responseMimeType\": \"application/json\"\n  }\n}"
      },
      "id": "node-extract-details",
      "name": "Extract Booking Details",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        250,
        50
      ],
      "typeVersion": 4.1,
      "notes": "Extracts the 8 variables from the customer's raw WhatsApp text."
    },
    {
      "parameters": {
        "jsCode": "const phone = $node['WhatsApp Trigger'].json.messages[0].from;\nconst rawExtract = JSON.parse($input.first().json.candidates[0].content.parts[0].text);\n\n// We access n8n static data representing our long-term session cache for each phone number\nconst staticData = getWorkflowStaticData('global');\nif (!staticData.sessions) staticData.sessions = {};\nif (!staticData.sessions[phone]) {\n  staticData.sessions[phone] = {\n    fullName: null,\n    phoneNumber: phone,\n    serviceName: null,\n    preferredDate: null,\n    preferredTime: null,\n    paymentMethod: 'cash',\n    paymentStatus: 'pending',\n    notes: null\n  };\n}\n\nconst session = staticData.sessions[phone];\n\n// Merge newly extracted variables only if they are not null\nif (rawExtract.fullName) session.fullName = rawExtract.fullName;\nif (rawExtract.serviceName) session.serviceName = rawExtract.serviceName;\nif (rawExtract.preferredDate) session.preferredDate = rawExtract.preferredDate;\nif (rawExtract.preferredTime) session.preferredTime = rawExtract.preferredTime;\nif (rawExtract.paymentMethod) session.paymentMethod = rawExtract.paymentMethod;\nif (rawExtract.paymentStatus) session.paymentStatus = rawExtract.paymentStatus;\nif (rawExtract.notes) session.notes = rawExtract.notes;\n\nreturn [{ json: { session, phone } }];"
      },
      "id": "node-merge-state",
      "name": "Merge State Node",
      "type": "n8n-nodes-base.code",
      "position": [
        450,
        50
      ],
      "typeVersion": 2,
      "notes": "Maintains conversation memory state machines in n8n workflow static variables."
    },
    {
      "parameters": {
        "jsCode": "const { session, phone } = $input.first().json;\n\n// Checking the missing fields sequentially\nlet missingField = null;\nlet promptMessage = '';\n\nif (!session.fullName) {\n  missingField = 'fullName';\n  promptMessage = \"Thank you! I'd love to help you book an appointment. Could you please share your full name first?\";\n} else if (!session.serviceName) {\n  missingField = 'serviceName';\n  promptMessage = `Hi ${session.fullName}! What treatment or service would you like to book? (We offer Gel Manicures, Luxury Pedicures, Gel Extensions, Botox sessions, and Lip Fillers!)`;\n} else if (!session.preferredDate) {\n  missingField = 'preferredDate';\n  promptMessage = `Got it! A ${session.serviceName}. What date would you prefer for your visit? (e.g. YYYY-MM-DD, tomorrow, or this Saturday)`;\n} else if (!session.preferredTime) {\n  missingField = 'preferredTime';\n  promptMessage = \"And what time fits your schedule? Mon-Sat 9AM-7PM, Sun 10AM-5PM. (e.g., 2:30 PM, 11:00 AM)\";\n}\n\nconst isComplete = !missingField;\n\nreturn [{ json: { isComplete, missingField, promptMessage, session, phone } }];"
      },
