    {
      "parameters": {
        "jsCode": "const phone = $node['Reset State on Cancel'].json.phone;\nconst appointments = $input.first().json.data || [];\n\n// Find active appointment matching client phone\nconst targetApp = appointments.find(app => app.clients && app.clients.phone_number === phone);\n\nreturn [{ json: { phone, appointmentFound: !!targetApp, appointmentId: targetApp ? targetApp.id : null, serviceName: targetApp ? targetApp.service_name : '' } }];"
      },
