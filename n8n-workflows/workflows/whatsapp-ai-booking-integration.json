    {
      "parameters": {
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key={{$env.GEMINI_API_KEY}}",
        "method": "POST",
        "sendHeaders": true,
        "headers": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"role\": \"user\",\n      \"parts\": [\n        {\n          \"text\": \"Classify the following incoming text message from a salon customer into exactly one of these categories: [general_inquiry, book_appointment, reschedule_appointment, check_appointment, cancel_appointment].\\n\\nDefinitions:\\n- general_inquiry: User asks about services, pricing, hours, location, policies, or standard conversation.\\n- book_appointment: User wants to schedule a new appointment or book a treatment.\\n- reschedule_appointment: User wants to change the date, time, or staff of an existing appointment.\\n- check_appointment: User wants to know details of their upcoming appointment.\\n- cancel_appointment: User explicitly asks to cancel, delete, or remove their booking.\\n\\nReturn ONLY a raw JSON string like this: { \\\"intent\\\": \\\"book_appointment\\\" } without markdown fences.\\n\\nCustomer Message: {{ $json.messages[0].text.body }}\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0.1,\n    \"responseMimeType\": \"application/json\"\n  }\n}"
      },
      "id": "node-intent-detection",
      "name": "Intent Detection Node",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        -450,
        50
      ],
      "typeVersion": 4.1,
      "notes": "Determines intent using Gemini 2.5 Flash under a structured JSON response schema."
    },
    {
      "parameters": {
        "jsCode": "const responseText = $input.first().json.candidates[0].content.parts[0].text;\ntry {\n  const parsed = JSON.parse(responseText);\n  return [{ json: { intent: parsed.intent || 'general_inquiry' } }];\n} catch (e) {\n  return [{ json: { intent: 'general_inquiry' } }];\n}"
      },
