    {
      "parameters": {
        "jsCode": "const { message, suggestions } = $input.first().json;\nconst suggestionsList = suggestions && suggestions.length > 0 \n  ? suggestions.map(time => `• ${time}`).join('\\n')\n  : 'Please pick another time.';\nconst text = `⚠️ I'm sorry, that slot is already booked.\\n\\nWould you prefer any of these 3 alternative times instead?\\n${suggestionsList}\\n\\nSimply type the preferred time to complete your booking! 🌸`;\nreturn [{ json: { text } }];"
