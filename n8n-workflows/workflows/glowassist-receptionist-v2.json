    {
      "parameters": {
        "jsCode": "const phone = $node['WhatsApp Trigger1'].json.messages[0].from;\nconst responseText = $input.first().json.text || '{}';\n// Strip markdown fences if model adds them\nconst cleaned = responseText.replace(/```json?/gi, '').replace(/```/g, '').trim();\nlet rawExtract = {};\ntry { rawExtract = JSON.parse(cleaned); } catch (e) { rawExtract = {}; }\n\n// We access n8n static data representing our long-term session cache for each phone number\nconst staticData = getWorkflowStaticData('global');\nif (!staticData.sessions) staticData.sessions = {};\nif (!staticData.sessions[phone]) {\n  staticData.sessions[phone] = {\n    fullName: null,\n    phoneNumber: phone,\n    serviceName: null,\n    preferredDate: null,\n    preferredTime: null,\n    paymentMethod: 'cash',\n    paymentStatus: 'pending',\n    notes: null\n  };\n}\n\nconst session = staticData.sessions[phone];\n\n// Merge newly extracted variables only if they are not null\nif (rawExtract.fullName) session.fullName = rawExtract.fullName;\nif (rawExtract.serviceName) session.serviceName = rawExtract.serviceName;\nif (rawExtract.preferredDate) session.preferredDate = rawExtract.preferredDate;\nif (rawExtract.preferredTime) session.preferredTime = rawExtract.preferredTime;\nif (rawExtract.paymentMethod) session.paymentMethod = rawExtract.paymentMethod;\nif (rawExtract.paymentStatus) session.paymentStatus = rawExtract.paymentStatus;\nif (rawExtract.notes) session.notes = rawExtract.notes;\n\nreturn [{ json: { session, phone } }];"
      },
      "id": "node-merge-state",
      "name": "Merge State Node",
      "type": "n8n-nodes-base.code",
      "position": [
        350,
        150
      ],
      "typeVersion": 2,
      "notes": "Maintains conversation memory state machines in n8n workflow static variables."
    },
    {
      "parameters": {
        "jsCode": "const { session, phone } = $input.first().json;\n\n// Checking the missing fields sequentially\nlet missingField = null;\nlet promptMessage = '';\n\nif (!session.fullName) {\n  missingField = 'fullName';\n  promptMessage = \"Thank you for reaching out to Lumière Med Spa! 🌸 I'd love to help you book an appointment. Could you please share your full name first?\";\n} else if (!session.serviceName) {\n  missingField = 'serviceName';\n  promptMessage = `Hi ${session.fullName}! ✨ What treatment would you like to book?\\n\\nOur services:\\n💅 Gel Manicure Deluxe — $45\\n🦶 Luxury Pedicure — $60\\n💎 Full Gel Nail Extensions — $85\\n💉 Botox Aesthetic Session — $350\\n👄 Lip Dermal Filler Session — $480\\n\\nJust type the name of the treatment you'd like!`;\n} else if (!session.preferredDate) {\n  missingField = 'preferredDate';\n  promptMessage = `Got it! A ${session.serviceName}. 📅 What date would you prefer for your visit? (e.g. YYYY-MM-DD, tomorrow, or this Saturday)`;\n} else if (!session.preferredTime) {\n  missingField = 'preferredTime';\n  promptMessage = \"And what time fits your schedule? 🕒\\nWe're open Mon–Sat 9:00 AM–7:00 PM and Sunday 10:00 AM–5:00 PM.\\n(e.g., 2:30 PM, 11:00 AM)\";\n}\n\nconst isComplete = !missingField;\n\nreturn [{ json: { isComplete, missingField, promptMessage, session, phone } }];"
      },
      "id": "node-questionnaire-state",
      "name": "Collect User Details Node",
      "type": "n8n-nodes-base.code",
      "position": [
        550,
        150
      ],
      "typeVersion": 2,
      "notes": "State machine that evaluates variables. Prompts next question sequentially if data is missing."
    },
