{
      "parameters": {
        "prompt": {
          "values": [
            {
              "type": "HumanMessagePromptTemplate",
              "message": {
                "values": [
                  {
                    "type": "text",
                    "value": "Classify the following incoming text message from a salon customer into exactly one of these categories: [general_inquiry, book_appointment, reschedule_appointment, check_appointment, cancel_appointment].\n\nDefinitions:\n- general_inquiry: User asks about services, pricing, hours, location, policies, or standard conversation.\n- book_appointment: User wants to schedule a new appointment or book a treatment.\n- reschedule_appointment: User wants to change the date, time, or staff of an existing appointment.\n- check_appointment: User wants to know details of their upcoming appointment.\n- cancel_appointment: User explicitly asks to cancel, delete, or remove their booking.\n\nReturn ONLY a raw JSON string like this: { \"intent\": \"book_appointment\" } — no markdown fences, no explanation, just the JSON.\n\nCustomer Message: {{ $json.messages[0].text.body }}"
                  }
                ]
              }
            }
          ]
        }
      },
      "id": "node-intent-detection",
      "name": "Intent Detection Node",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        -450,
        50
      ],
      "typeVersion": 1.5,
      "notes": "Classifies customer intent using Llama 3.3 70B via LangChain Basic LLM Chain."
    },
    {
      "parameters": {
        "jsCode": "const responseText = $input.first().json.text || '';\ntry {\n  // Strip markdown fences if model adds them despite instructions\n  const cleaned = responseText.replace(/```json?/gi, '').replace(/```/g, '').trim();\n  const parsed = JSON.parse(cleaned);\n  return [{ json: { intent: parsed.intent || 'general_inquiry' } }];\n} catch (e) {\n  // Fallback: scan text for any known intent keyword\n  const text = responseText.toLowerCase();\n  if (text.includes('book_appointment')) return [{ json: { intent: 'book_appointment' } }];\n  if (text.includes('cancel_appointment')) return [{ json: { intent: 'cancel_appointment' } }];\n  if (text.includes('reschedule_appointment')) return [{ json: { intent: 'reschedule_appointment' } }];\n  if (text.includes('check_appointment')) return [{ json: { intent: 'check_appointment' } }];\n  return [{ json: { intent: 'general_inquiry' } }];\n}"
      },
